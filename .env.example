# Copy to .env and fill in. Never commit .env.
# Pick a provider name from app/core/providers.json, then paste a key.
# Everything else has a sensible default -- you normally only need 2 lines.

# --- Chat model: reads your library and proposes categories ---
LLM_PROVIDER=deepseek
LLM_API_KEY=
# Optional overrides if the preset is out of date
# LLM_MODEL=
# LLM_BASE_URL=

# --- Embedding model: turns each item into a vector ---
# Leave both empty if your chat provider also serves embeddings.
EMBEDDING_PROVIDER=zhipu
EMBEDDING_API_KEY=
# EMBEDDING_MODEL=
# EMBEDDING_BASE_URL=

# --- Bilibili ---
BILI_UID=
BILI_SESSDATA=
BILI_CSRF=

# --- App ---
# No host/port here: scripts/serve.py always binds 127.0.0.1 and takes the
# first free port from 8000 up, so a value in this file would be ignored.
